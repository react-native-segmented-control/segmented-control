{
  "name": "@react-native-segmented-control/segmented-control",
  "version": "2.5.8",
  "description": "React Native SegmentedControlIOS library",
  "main": "js/index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "ios",
    "js",
    "!js/__tests__",
    "react-native-segmented-control.podspec"
  ],
  "scripts": {
    "start": "react-native start",
    "test": "pnpm flow && pnpm lint",
    "ios": "cd example && react-native run-ios",
    "android": "react-native run-android",
    "web": "pnpm --filter SegmentedControlExampleWeb start",
    "flow": "flow",
    "lint": "eslint . --cache",
    "tsc": "tsc --noEmit",
    "release": "release-it"
  },
  "peerDependencies": {
    "react": ">=16.0",
    "react-native": ">=0.62"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-flow": "^7.27.0",
    "@babel/preset-react": "^7.27.0",
    "@babel/runtime": "^7.29.14",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.2.0",
    "eslint": "8",
    "flow-bin": "^0.331.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "release-it": "^21.1.2",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.2"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-segmented-control/segmented-control.git"
  },
  "keywords": [
    "SegmentedControlIOS",
    "react-native"
  ],
  "author": "M.Haris Baig",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-native-segmented-control/segmented-control/issues"
  },
  "homepage": "https://github.com/react-native-segmented-control/segmented-control#readme",
  "publishConfig": {
    "access": "public"
  }
}
